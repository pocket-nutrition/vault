# Pocket Nutrition Vault: configuration template.
# Copy it to .env, fill in the secrets and adjust what you need:  cp .env.example .env
#
# Every setting is an environment variable with the VAULT_ prefix (see app/config.py). The server does not
# load a .env file itself: export the variables, or pass the file to Docker with `--env-file .env`.
# Keep plain KEY=value lines (no quotes, no trailing comments) so Docker reads them as written.
# Unless a comment says otherwise, the values below are the built-in defaults.

# === Database and secrets (set these) ===

# Database URL: PostgreSQL for real use (add your password after the colon); sqlite:///./vault.db is fine for a trial run.
VAULT_DATABASE_URL=postgresql://vault:@localhost:5432/vault
# Secret for POST /admin/accounts (account with an API key only); the endpoint is disabled while empty. Try: openssl rand -hex 32
VAULT_ADMIN_TOKEN=
# Secret keying the fake KDF salts for unknown usernames; set it so they survive restarts. Try: openssl rand -hex 32
VAULT_PRELOGIN_SECRET=

# === Accounts ===

# Name shown by the apps (GET /v1/server-info) and used as the issuer in authenticator apps; use your own.
VAULT_SERVER_NAME=Pocket Nutrition Vault
# open: anyone can register (rate-limited, quota-bound); closed: accounts come only from POST /admin/accounts.
VAULT_REGISTRATION=open
# Most linked devices (owner API keys) per account.
VAULT_MAX_DEVICES=20
# Most active external-reader grants per account.
VAULT_MAX_GRANTS=20
# Most pending (unexpired) write-only drop tokens per account.
VAULT_MAX_PENDING_DROPS=100

# === Storage and size limits ===

# Stored ciphertext allowed per account, in bytes (base64 characters, as stored): 50 MiB.
VAULT_QUOTA_BYTES=52428800
# Bookkeeping bytes charged against the quota for every stored row, tombstones included.
VAULT_ROW_OVERHEAD_BYTES=256
# Days a deletion tombstone is kept; a device offline for longer must resync from scratch.
VAULT_TOMBSTONE_RETENTION_DAYS=90
# Largest record, in decoded ciphertext bytes: 256 KiB.
VAULT_MAX_RECORD_BYTES=262144
# Largest keyring blob, in bytes: 16 KiB.
VAULT_MAX_KEYRING_BYTES=16384
# Largest request body, in bytes, enforced while reading and before JSON parsing: 1 MiB.
VAULT_MAX_BODY_BYTES=1048576
# Most records GET /v1/sync returns in one page.
VAULT_MAX_PAGE_SIZE=500

# === Abuse limits ===

# Failed credential checks (passphrase or second factor) before an account is locked.
VAULT_LOGIN_MAX_FAILURES=5
# Seconds an account stays locked: 15 minutes.
VAULT_LOGIN_LOCK_S=900
# Registrations allowed per client IP per hour.
VAULT_REGISTER_PER_HOUR_PER_IP=10
# Prelogin, login and passphrase requests allowed per client IP per 10 minutes.
VAULT_LOGIN_PER_10MIN_PER_IP=30
# Two-factor setup, enable and disable requests allowed per client IP per 10 minutes.
VAULT_TWO_FACTOR_PER_10MIN_PER_IP=10
# Reverse proxies in front of the app that append to X-Forwarded-For (0 if none); verify it, a wrong value breaks per-IP limits.
VAULT_TRUSTED_PROXY_HOPS=1
# Argon2 hashes allowed at once, process-wide (about 19 MiB each); excess requests wait, then get a 503.
VAULT_ARGON_CONCURRENCY=2
# Seconds a request waits for an Argon2 slot before it gets a 503.
VAULT_ARGON_WAIT_S=5

# === Apps and browsers ===

# Comma-separated "TEAMID.bundle.id" iOS app IDs served in /.well-known/apple-app-site-association; not served while empty.
VAULT_APPLE_APP_IDS=
# Comma-separated browser origins allowed to call the API (a web viewer); empty means none. Never "*".
VAULT_CORS_ORIGINS=
